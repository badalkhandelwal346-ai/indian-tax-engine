{
  "name": "india-tax-engine",
  "version": "0.1.0",
  "description": "Deterministic, offline Indian income-tax calculator with an explainable trace (prototype, informational only)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "india",
    "income-tax",
    "tax",
    "calculator",
    "typescript",
    "new-regime",
    "old-regime"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "pack:check": "npm pack --dry-run",
    "validate-rules": "tsx scripts/validate-rules.ts",
    "verify": "npm run typecheck && npm run validate-rules && npm test",
    "consumer-test": "npm run build && node scripts/consumer-test.mjs",
    "prepublishOnly": "npm run verify && npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
